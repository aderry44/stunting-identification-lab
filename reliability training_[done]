out","text":["Device: cuda\n"]}]},{"cell_type":"markdown","source":["### Sc.4.b. SGD Focal Loss"],"metadata":{"id":"P330Aq5EHjkN"}},{"cell_type":"code","source":["# Class Weight\n","train_counts = train_sc4a_df[\"label\"].value_counts().sort_index().to_dict()\n","n0 = train_counts.get(0, 1)\n","n1 = train_counts.get(1, 1)\n","\n","# Rare class (1) gets HIGH weight, frequent class (0) gets LOW weight\n","base_class_weights = torch.tensor([1.0 / n0, 1.0 / n1], dtype=torch.float32, device=device)"],"metadata":{"id":"fLzv_VxDpXyA","executionInfo":{"status":"ok","timestamp":1788999851545,"user_tz":-420,"elapsed":21,"user":{"displayName":"Derry Alamsyah","userId":"16456265919386018795"}}},"execution_count":53,"outputs":[]},{"cell_type":"code","source":["GAMMA = 2.0\n","\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","# Focal Loss\n","class FocalLoss(nn.Module):\n","    def __init__(self, weight=None, gamma=2.0):\n","        super().__init__()\n","        self.weight = weight\n","        self.gamma = gamma\n","\n","    def forward(self, logits, targets):\n","        ce = F.cross_entropy(logits, targets, reduction=\"none\")\n","        pt = torch.exp(-ce)\n","        focal_term = (1 - pt) ** self.gamma\n","        loss = focal_term * ce\n","\n","        if self.weight is not None:\n","            sample_weights = self.weight[targets]\n","            loss = sample_weights * loss\n","            loss = loss.sum() / sample_weights.sum()\n","        else:\n","            loss = loss.mean()\n","\n","        return loss\n","\n","alpha     = base_class_weights\n","criterion = FocalLoss(weight=alpha, gamma=GAMMA)"],"metadata":{"id":"qsdaa5K7H1xF","executionInfo":{"status":"ok","timestamp":1788999851549,"user_tz":-420,"elapsed":5,"user":{"displayName":"Derry Alamsyah","userId":"16456265919386018795"}}},"execution_count":54,"outputs":[]},{"cell_type":"markdown","source":["### Sc.4.b. SGD Focal Loss Training"],"metadata":{"id":"6I6F6HWJHqCK"}},{"cell_type":"code