ss_weights = torch.tensor([1.0 / n0, 1.0 / n1], dtype=torch.float32, device=device)"],"metadata":{"id":"Ll4SujTGpFlg","executionInfo":{"status":"ok","timestamp":1788999522799,"user_tz":-420,"elapsed":37,"user":{"displayName":"Derry Alamsyah","userId":"16456265919386018795"}}},"execution_count":31,"outputs":[]},{"cell_type":"code","source":["GAMMA = 2.0\n","\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","# Focal Loss\n","class FocalLoss(nn.Module):\n","    def __init__(self, weight=None, gamma=2.0):\n","        super().__init__()\n","        self.weight = weight\n","        self.gamma = gamma\n","\n","    def forward(self, logits, targets):\n","        ce = F.cross_entropy(logits, targets, reduction=\"none\")\n","        pt = torch.exp(-ce)\n","        focal_term = (1 - pt) ** self.gamma\n","        loss = focal_term * ce\n","\n","        if self.weight is not None:\n","            sample_weights = self.weight[targets]\n","            loss = sample_weights * loss\n","            loss = loss.sum() / sample_weights.sum()\n","        else:\n","            loss = loss.mean()\n","\n","        return loss\n","\n","alpha     = base_class_weights\n","criterion = FocalLoss(weight=alpha, gamma=GAMMA)"],"metadata":{"id":"XKQDlKshob5n","executionInfo":{"status":"ok","timestamp":1788999522807,"user_tz":-420,"elapsed":3,"user":{"displayName":"Derry Alamsyah","userId":"16456265919386018795"}}},"execution_count":32,"outputs":[]},{"cell_type":"code","source":["# SGD\n","LR          = 1e-3\n","MOMENTUM    = 0.9\n","WEIGHT_DECAY= 1e-4\n","NESTEROV    = True\n","\n","optimizer = torch.optim.SGD(\n","    model.parameters(),\n","    lr=LR,\n","    momentum=MOMENTUM,\n","    weight_decay=WEIGHT_DECAY,\n","    nesterov=NESTEROV\n","    )\n","\n","scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)"],"metadata":{"id":"UGCx1hhfLpVx","executionInfo":{"status":"ok","timestamp":1788999522814,"user_tz":-420,"elapsed":3,"user":{"displayName":"Der